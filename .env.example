# Copy to server/.env and fill in. Never commit the real file.

PORT=3002
NODE_ENV=development

# Interface to bind. Loopback by default: this process holds database
# credentials and has no authentication, so 0.0.0.0 would expose it to the
# whole local network.
HOST=127.0.0.1

# Browser origins allowed to call the API. Comma separated.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Shared secret for /api routes, sent as the x-api-token header. Optional on
# loopback, REQUIRED if you change HOST to anything else.
# API_TOKEN=

# Include the server's own connection settings in error responses. Useful when
# debugging a connection failure, off by default because it tells the caller
# the hostname and username of a database they may know nothing about.
# DEBUG_CONNECTION_DETAILS=false

# Default connection, used when a request does not name one.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Additional connections. DB1_ through DB10_ are scanned at startup;
# a connection is registered only if its _HOST is set.
# DB1_NAME=Local
# DB1_HOST=localhost
# DB1_PORT=5432
# DB1_DATABASE=postgres
# DB1_USER=postgres
# DB1_PASSWORD=

# Use a read-only role. The analyzer only reads pg_catalog and pg_stat_*,
# so it never needs write access to the database it is inspecting.
